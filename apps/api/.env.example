SUPERADMIN_PASSWORD=Test@1234
DEV_AUTH=true
DEV_OTP_CODE=123456
JWT_SECRET=dev-change-me-society-hub-jwt-secret-32chars
# Local MySQL (Workbench / native server on 3306). @ in password → %40
# Docker Compose MySQL uses host port 3307 instead.
DATABASE_URL=mysql://root:1900Summer%40@127.0.0.1:3306/societyhub
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://app.localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://manage.localhost:5174
PUBLIC_API_URL=http://localhost:3000
PORT=3000
UPLOAD_DIR=./uploads
# Client app base for invite deep links
PUBLIC_APP_URL=http://app.localhost:5173
# Google SSO — Web OAuth client ID. Empty = local accepts idToken "dev:<phone>"
# GOOGLE_CLIENT_ID=583640086898-xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET is not required for the GIS id-token flow; keep it on the server only.
# Optional: Resend for invite emails (stubbed when unset)
# RESEND_API_KEY=
# RESEND_FROM=SocietyHub <noreply@yourdomain.com>
# Optional: Gupshup WhatsApp (stubbed when unset). Swap adapter later for Meta WABA.
# GUPSHUP_API_KEY=
# GUPSHUP_SOURCE=91xxxxxxxxxx
# GUPSHUP_APP_NAME=SocietyHub
